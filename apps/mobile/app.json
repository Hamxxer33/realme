{
  "expo": {
    "name": "Realme",
    "slug": "realme",
    "scheme": "realme",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.realme.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.realme.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDEEF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFF8F5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Realme to use your microphone for voice notes and calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Realme to access your photos so you can share them with your partner.",
          "cameraPermission": "Allow Realme to use your camera for photos and video calls.",
          "microphonePermission": "Allow Realme to use your microphone for voice notes and calls."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2385E"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Realme to use your camera for photos and video calls.",
          "microphonePermission": "Allow Realme to use your microphone for voice notes and calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
