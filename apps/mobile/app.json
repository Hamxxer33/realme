{
  "expo": {
    "name": "Lovenest",
    "slug": "lovenest",
    "scheme": "lovenest",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lovenest.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lovenest.app",
      "adaptiveIcon": {
        "backgroundColor": "#C94570",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFF8F5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lovenest to use your microphone for voice notes and calls.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lovenest to access your photos so you can share them with your partner.",
          "cameraPermission": "Allow Lovenest to use your camera for photos and video calls.",
          "microphonePermission": "Allow Lovenest to use your microphone for voice notes and calls."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2385E"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Lovenest to use your camera for photos and video calls.",
          "microphonePermission": "Allow Lovenest to use your microphone for voice notes and calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
