PORT=8787
# Neon → Connection details → pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/realme?sslmode=require
# openssl rand -base64 48
JWT_SECRET=
# Any S3-compatible bucket (Cloudflare R2 shown). Keep it private; the app uses presigned URLs.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=realme-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local development without a bucket: comment out the S3_* lines and set these instead.
# STORAGE_DIR=./.media
# PUBLIC_URL=http://192.168.1.10:8787

# Optional: Expo push security token
EXPO_ACCESS_TOKEN=
